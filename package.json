{
  "name": "codex-dog",
  "productName": "Codex Dog",
  "version": "0.6.0-g06",
  "private": true,
  "type": "module",
  "main": "out/main.cjs",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "pnpm typecheck && node scripts/build.mjs",
    "typecheck": "vue-tsc --noEmit",
    "start": "node scripts/launch.mjs",
    "dev": "pnpm build && pnpm start",
    "cli": "node out/cli.cjs",
    "pack:cli": "node scripts/pack-cli.mjs",
    "install:electron": "node scripts/ensure-electron.mjs",
    "test": "node --test test/*.test.ts test/*.test.mjs",
    "test:g01": "node scripts/g02-smoke.mjs --g01-only",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "test:g02": "node scripts/g02-smoke.mjs",
    "test:g03": "node scripts/g03-smoke.mjs",
    "test:g04": "node scripts/g04-smoke.mjs",
    "pack:g05": "node scripts/package-g05.mjs",
    "test:g05": "node scripts/g05-smoke.mjs",
    "release:check": "node scripts/package-release.mjs --check",
    "release:build": "node scripts/package-release.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test:g06": "node scripts/g06-smoke.mjs",
    "test:stage2": "node scripts/stage2-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "builder-util-runtime": "9.7.0",
    "electron-updater": "6.8.11",
    "element-plus": "2.14.8",
    "pinia": "4.1.0",
    "semver": "7.7.3",
    "vue": "3.5.45",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/semver": "7.7.1",
    "@vue/compiler-sfc": "3.5.45",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.14",
    "yaml": "2.9.1"
  },
  "description": "Codex Dog 独立桌面管理工具（G06 发行准备）",
  "author": "crankfreedom"
}
